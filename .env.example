# Traefik Sentinel Configuration
# Copy this file to .env and adjust the values

# =============================================================================
# REQUIRED SETTINGS
# =============================================================================

# Path to your Traefik access log directory on the host
TRAEFIK_LOG_DIR=/var/log/traefik

# =============================================================================
# OPTIONAL: Telegram Alerts
# =============================================================================
# Get bot token from @BotFather on Telegram
# Get chat ID by messaging your bot and visiting:
# https://api.telegram.org/bot<TOKEN>/getUpdates

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# =============================================================================
# OPTIONAL: AbuseIPDB Integration
# =============================================================================
# Get a free API key at https://www.abuseipdb.com/account/api
# Enables: IP reputation checks, auto-blocking of known bad actors,
#          automatic reporting of attackers

ABUSEIPDB_API_KEY=
ABUSEIPDB_AUTO_REPORT=true

# =============================================================================
# INTRUDER DETECTION THRESHOLDS
# =============================================================================

# Rate limiting: max requests per IP within time window
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Auth failure tracking
AUTH_FAILURE_THRESHOLD=10
AUTH_FAILURE_WINDOW_SECONDS=300

# IPs that should never trigger alerts (comma-separated)
WHITELISTED_IPS=

# =============================================================================
# HONEYPOT SETTINGS
# =============================================================================

# Instantly block IPs that access honeypot paths (wp-admin, .env, etc.)
HONEYPOT_INSTANT_BLOCK=true

# =============================================================================
# LOG RETENTION
# =============================================================================

# How long to keep different types of data (in days)
RETENTION_ACCESS_LOGS_DAYS=30
RETENTION_INTRUDER_EVENTS_DAYS=90
RETENTION_BLOCKED_IPS_INACTIVE_DAYS=180

# =============================================================================
# DIGEST SCHEDULING
# =============================================================================

# --- Digest scheduling (Phase 3) ---
# DIGEST_ENABLED: master switch for the daily digest background task.
# When false, the scheduler does not start. Manual endpoints
# (/api/digest/send, /api/digest/preview) remain available regardless.
# Default: true
DIGEST_ENABLED=true

# DIGEST_HOUR: UTC hour (0-23) at which the daily digest fires.
# Invalid values fall back to 8 with a warning in logs.
# Default: 8 (08:00 UTC)
DIGEST_HOUR=8

# =============================================================================
# SERVER SETTINGS
# =============================================================================

# Port to expose the dashboard on
PORT=13923

# Timezone
TZ=UTC

# =============================================================================
# DIGEST SCHEDULING (Phase 3)
# =============================================================================

# DIGEST_ENABLED: master switch for the daily digest background task.
# When false, the scheduler does not start. Manual endpoints
# (/api/digest/send, /api/digest/preview) remain available regardless.
# Default: true
DIGEST_ENABLED=true

# DIGEST_HOUR: UTC hour (0-23) at which the daily digest fires.
# Invalid values fall back to 8 with a warning in logs.
# Default: 8 (08:00 UTC)
DIGEST_HOUR=8
